{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "service:install": "./scripts/install-launch-agent.sh",
    "service:uninstall": "./scripts/install-launch-agent.sh uninstall",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/local.lifeos",
    "service:status": "launchctl print gui/$(id -u)/local.lifeos | grep -E 'state|pid'",
    "service:logs": "tail -f .lifeos/server.log",
    "test": "vitest run",
    "postinstall": "xattr -w com.apple.fileprovider.ignore#P 1 node_modules 2>/dev/null || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
