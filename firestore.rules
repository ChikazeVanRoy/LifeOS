rules_version = '2';

service cloud.firestore {
  // Two people share this app. Each can read the other's data, but only write their own.
  // Who they are lives in the database, in config/household (a list of emails), not in this
  // public repository. Only the Firebase console or an admin can change that document.
  // The email must be verified, so nobody can claim a listed address just by signing up with it.
  function household() {
    return request.auth != null
      && request.auth.token.email_verified == true
      && request.auth.token.email.lower() in get(/databases/(default)/documents/config/household).data.emails;
  }

  match /databases/{database}/documents {
    match /users/{owner}/{document=**} {
      allow read: if household();
      allow write: if household() && request.auth.uid == owner;
    }
    // An iPhone Shortcut can add one day of health numbers without signing in, by including the
    // secret in users/{owner}/config/health. It can write only these few fields, to a date-named
    // document, and cannot read anything.
    match /users/{owner}/health/{day} {
      allow create, update: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['key', 'steps', 'workoutMinutes', 'weight', 'sleepHours'])
        && request.resource.data.key is string
        && request.resource.data.key == get(/databases/(default)/documents/users/$(owner)/config/health).data.key;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
