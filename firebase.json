{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "/goals/**", "destination": "/goals/_/index.html" }],
    "headers": [
      { "source": "/_next/static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
